# Copy to .env — never commit real keys. Server-only, never to mobile.
# The backend needs a real key to boot; there is no keyless fallback.
OPENROUTER_API_KEY=  (server-only, never to mobile)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Legacy OPENAI_API_KEY / OPENAI_MODEL still work as fallback.
# Conversation persistence: memory (default, key-free) or supabase.
# CONVERSATION_STORE=memory
# CONVERSATION_STORE=supabase
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=  (sb_secret_... — server-only, never to mobile)

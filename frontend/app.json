{
  "expo": {
    "name": "LiAI",
    "slug": "liai",
    "scheme": "liai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LiAI needs the camera to see what you see."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.liai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "LiAI needs the camera to see what you see.",
          "enableFrameProcessors": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bac1850f-bdb6-44f4-b3b5-d7036c8a0fb0"
      }
    }
  }
}

# Dev-only: enable Expo's EXPO_USE_METRO_REQUIRE mode, whose observable effect
# here is stable (path-based) Metro module IDs instead of numeric ones.
# Numeric IDs are assigned per Metro process, so after a Metro restart the
# dev client can receive modules renumbered against its already-loaded bundle,
# which fails with "Requiring unknown module NNNN". Stable IDs are derived
# from the module path, so they survive restarts and graph changes.
# Not loaded for production exports (no bundle-size cost in releases).
EXPO_USE_METRO_REQUIRE=1

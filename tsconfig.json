{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./*"] }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "tests",
    "pocketpal-ai"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

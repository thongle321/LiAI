{
  "expo": {
    "name": "LiAI",
    "slug": "liai",
    "scheme": "liai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LiAI needs the camera to see what you see."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.liai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "LiAI needs the camera to see what you see.",
          "enableFrameProcessors": true
        }
      ],
      "./plugins/withCameraUsesFeature.js",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LiAI needs the microphone to hear your questions.",
          "speechRecognitionPermission": "LiAI needs speech recognition to transcribe your voice."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usePrecompiledHeaders": true,
            "buildToolsVersion": "36.0.0",
            "useHermesV1": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-secure-store",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#0B0C10",
            "image": "./assets/icon.png"
          },
          "image": "./assets/icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "LiAI needs your photo library to attach pictures to a message."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bac1850f-bdb6-44f4-b3b5-d7036c8a0fb0"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

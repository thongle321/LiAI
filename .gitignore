# Project files — everything else is ignored

# Secrets — server-only backup + local app env, never committed
.env.backup
.env.local
.env*.local

# Python (retired backend leftovers + caches)
/backend/.venv/
*.whl
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc

# Expo / Node
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native projects (regenerate with expo prebuild)
/ios/
/android/

# Reference / scratch — never part of the app
scratch/
prompt_material/
/models/
/pocketpal-ai/
.agents/
/.pi/
/.impeccable/
skills-lock.json

# Logs / OS / editors
npm-debug.log*
*.log
.DS_Store
.vscode/
.idea/
.gradle/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
yarn-debug.*
yarn-error.*

# macOS
*.pem


# Project files — everything else is ignored

# Secrets — server-only backup + local app env, never committed
.env.backup
.env.local
.env*.local

# Python (retired backend leftovers + caches)
*.whl
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc

# Expo / Node
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native projects (regenerate with expo prebuild)
/ios/
# android/ is deliberately COMMITTED — PocketPal's way: the generated
# manifest carries the two uses-feature camera lines (camera + camera.any,
# required=false) that keep camera-less devices installable from the Play
# Store, and android/.gitignore keeps build/, .cxx/, .gradle/ out.
# `expo prebuild --clean` discards tracked native edits — restore from git.

# Reference / scratch — never part of the app
scratch/
/models/
.agents/
/.pi/
/.impeccable/
skills-lock.json

# Vendored reference app (read it, never edit it, never ship it)

# Scratch material for prompts
/prompt_material/

# Local issue tracker (see docs/agents/issue-tracker.md) — local by design
/.scratch/

# Logs / OS / editors
npm-debug.log*
*.log
.DS_Store
.vscode/
.idea/
.gradle/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
yarn-debug.*
yarn-error.*

# macOS
*.pem

# TypeScript
*.tsbuildinfo

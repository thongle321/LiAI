<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <!--
    The download runs as a foreground service, and on API 33+ starting one
    without this throws. PocketPal needs no equivalent: it has no foreground
    service at all, which is why its transfers are bounded by WorkManager's
    ten-minute cap — a limit every multi-GB model crosses.

    Declared here rather than in a config plugin so prebuild carries it
    through the module manifest merge with no extra wiring.
  -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    Ticket 06: on API 34+ the scheduler prefers a JobScheduler
    user-initiated job for the transfer. Scheduling one without this
    permission throws, which the scheduler treats as "fall back to
    WorkManager" — so without it the new path would never engage at all.
    Carries through prebuild like POST_NOTIFICATIONS above, no plugin
    wiring needed.
  -->
  <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />

  <!--
    Android 14+ (API 34) requires the foreground service type to be declared
    in the manifest. WorkManager declares SystemForegroundService in its own
    manifest WITHOUT a type, so the merge yields 0x00000000 and setForeground()
    throws:
      foregroundServiceType 0x00000001 is not a subset of
      foregroundServiceType attribute 0x00000000 in service element
    tools:replace overrides WorkManager's attribute with the type the worker
    actually uses (FOREGROUND_SERVICE_TYPE_DATA_SYNC = dataSync).

    The <application> wrapper is required: a <service> directly under <manifest>
    is rejected by AAPT with "unexpected element <service> found in <manifest>".
  -->
  <application>
    <service
        android:name="androidx.work.impl.foreground.SystemForegroundService"
        android:foregroundServiceType="dataSync"
        tools:replace="android:foregroundServiceType" />

    <!--
      The user-initiated job host (ticket 06): the JobScheduler-only
      counterpart of the WorkManager worker above. BIND_JOB_SERVICE is what
      lets the system bind and start it; exported stays false because
      nothing outside the system asks for it.
    -->
    <service
        android:name="com.anonymous.liai.download.DownloadJobService"
        android:permission="android.permission.BIND_JOB_SERVICE"
        android:exported="false" />
  </application>
</manifest>